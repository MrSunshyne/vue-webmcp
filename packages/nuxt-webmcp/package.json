{
  "name": "nuxt-webmcp",
  "version": "0.1.0",
  "description": "Nuxt module for WebMCP: auto-imports the vue-webmcp composable and injects Chrome origin-trial tokens.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Sandeep Ramgolam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrSunshyne/vue-webmcp.git",
    "directory": "packages/nuxt-webmcp"
  },
  "homepage": "https://github.com/MrSunshyne/vue-webmcp#readme",
  "bugs": {
    "url": "https://github.com/MrSunshyne/vue-webmcp/issues"
  },
  "keywords": [
    "nuxt",
    "nuxt-module",
    "webmcp",
    "mcp",
    "model-context",
    "ai",
    "agent"
  ],
  "exports": {
    ".": {
      "types": "./dist/types.d.mts",
      "import": "./dist/module.mjs"
    }
  },
  "main": "./dist/module.mjs",
  "types": "./dist/types.d.mts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "nuxt-module-build build"
  },
  "dependencies": {
    "@nuxt/kit": "^4.0.0",
    "vue-webmcp": "workspace:^"
  },
  "devDependencies": {
    "@nuxt/module-builder": "^1.0.0",
    "@nuxt/schema": "^4.5.1",
    "nuxt": "^4.0.0",
    "typescript": "^5.6.0"
  }
}
